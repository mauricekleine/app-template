{
  "name": "app-template",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 3000 --strictPort",
    "build": "bun run build:soliton && bun run build:cloudflare",
    "build:soliton": "vite build --mode soliton && bun --check",
    "build:cloudflare": "vite build --mode cloudflare && bun --check",
    "start": "bun src/serve.ts",
    "typecheck": "bun --check",
    "test": "bun test",
    "test:a11y": "bun tools/a11y.ts",
    "deploy:verify": "bun tools/deploy-verify.ts",
    "registry:install": "bun tools/registry-install.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "~1.8.0",
    "@tailwindcss/vite": "~4.3.3",
    "@tanstack/react-router": "~1.170.41",
    "@tanstack/react-start": "~1.168.60",
    "class-variance-authority": "~0.7.1",
    "cn": "~0.4.0",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "tailwindcss": "~4.3.3",
    "tw-animate-css": "~1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "~4.11.1",
    "@cloudflare/vite-plugin": "~1.62.3",
    "@types/bun": "~1.4.3",
    "@types/node": "~26.6.3",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "~6.1.1",
    "cf": "1.0.0-beta.18",
    "husky": "~9.1.7",
    "playwright": "~1.58.2",
    "shadcn": "~4.22.1",
    "taze": "21.3.0",
    "typescript": "7.0.2",
    "vite": "~8.3.1"
  },
  "engines": {
    "bun": "1.4.4",
    "node": "24.22.1"
  },
  "packageManager": "bun@1.4.4"
}
